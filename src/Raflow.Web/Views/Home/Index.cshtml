<main class="app">
    <header>
        <div class="brand">
            <img class="brand-mark" src="~/img/raflow-mark.svg" asp-append-version="true" alt="raflow logo"
                 height="40" /> <span><strong>raflow</strong><small>Decision Studio</small></span>
        </div>
        <div><span id="status">Loading…</span> <button id="save">Save changes</button></div>
    </header>
    <div class="layout">
        
        
        <aside class="workspace-sidebar">

            <!-- WORKSPACE -->
            <section class="workspace-section">
                <div class="accordion-heading">
                    <details open>
                        <summary>
                            <span class="sidebar-icon"><i class="fa-solid fa-industry"></i></i>&nbsp</span>
                            WORKSPACE
                        </summary>
                        <br />
                        <div id="workspaceTree" class="accordion-content">
                            <p class="workspace-empty">Loading workspace...</p>
                        </div>
                    </details>
                    <button id="addFolder" class="folder-add" type="button" title="Create folder">
                        <span class="fa-layers fa-fw">
                            <i class="fa-solid fa-folder"></i>&nbsp
                            <span class="folder-text">New folder</span>
                        </span>
                    </button>

                </div>
                <button id="addWorkflow" class="workspace-add" type="button" title="Create workflow">
                    <span class="fa-layers fa-fw">
                        <i class="fa-solid fa-diagram-project"></i>&nbsp
                        <span class="folder-text">New workflow</span>
                    </span>
                </button>
            </section>

            <!-- VERSION HISTORY -->
            <section class="workspace-section">
                <details open>
                    <summary>
                        <span class="sidebar-icon"><i class="fa-solid fa-clock-rotate-left"></i>&nbsp</span>
                        VERSION HISTORY
                    </summary>
                    <div id="workflowVersions" class="accordion-content">
                        <p class="workspace-empty">Select a workflow.</p>
                    </div>
                </details>
            </section>

            <!-- COMPONENTS -->
            <section class="workspace-section">
                <details open>
                    <summary>
                        <span class="sidebar-icon"><i class="fa-solid fa-puzzle-piece"></i>&nbsp</span>
                        COMPONENTS
                    </summary>
                    <br />
                    <div class="accordion-content">
                        <div class="component" draggable="true" data-component="request">
                            ↳ &nbsp; Request
                            <small>Input context</small>
                        </div>

                        <div class="component" draggable="true" data-component="decision">
                            ▦ &nbsp; Decision table
                            <small>Rules spreadsheet</small>
                        </div>

                        <div class="component" draggable="true" data-component="response">
                            ◉ &nbsp; Response
                            <small>Output context</small>
                        </div>
                        <div class="component" draggable="true" data-component="expression">
                            ƒx &nbsp; Expression
                        </div>
                        <p class="hint">Drag components onto the canvas. Select Connect nodes to create links.</p>
                    </div>
                </details>
            </section>

        </aside>


        <section class="main">
            <nav id="tabs">
                <button class="tab active" data-tab="flow">Flow</button>
                <button class="tab" data-tab="schema">Schema</button>
                <button class="tab" data-tab="data">Data</button>
                <button class="tab" data-tab="test">Test rule</button>
            </nav>
            <div id="tablePanels"></div>
            <section id="flow" class="panel flow">
                <div id="canvas"><svg id="wires"></svg>
                    <div id="nodes"></div>
                </div>
                <br />
                <div class="tools"><button id="addNode">＋ Add decision</button>&nbsp<button id="connect">Connect
                    nodes</button>&nbsp<button id="removeLink">Remove last connection</button></div>
                    <p class="hint">Drag nodes. To connect: click Connect nodes, then select source and destination.</p>
                </section>
                <section id="schema" class="panel hidden">
                    <div class="panel-header">
                        <div>
                            <h2>Data schema</h2>
                            <p>Define the structure of your workflow's input and output data.</p>
                        </div>
                    </div>

                    <div class="schema-toolbar">
                        <div class="schema-tabs">
                            <button class="schema-tab active" data-schema="input">
                                Input schema
                            </button>
                            <button class="schema-tab" data-schema="output">
                                Output schema
                            </button>
                        </div>

                        <button id="add-schema-field" class="primary">
                            + Add field
                        </button>
                    </div>


                    <div class="schema-editing-context">
                        <div class="schema-context-icon" id="schema-context-icon">↓</div>
                        <div>
                            <div class="schema-context-eyebrow">CURRENTLY EDITING</div>
                            <h3 id="schema-context-title">Input schema</h3>
                            <p id="schema-context-description">
                                Define the data your workflow receives.
                            </p>
                        </div>
                    </div>


                    <div id="input-schema" class="schema-content">
                        <div id="input-schema-fields" class="schema-fields">
                            <p class="muted">No input fields defined yet.</p>
                        </div>
                    </div>

                    <div id="output-schema" class="schema-content hidden">
                        <div id="output-schema-fields" class="schema-fields">
                            <p class="muted">No output fields defined yet.</p>
                        </div>
                    </div>
                </section>
                
                <section id="data" class="panel hidden">
                    <div class="panel-header">
                        <div>
                            <h2>Workflow data</h2>
                            <p>Define reusable variables and fixed constants for your workflow.</p>
                        </div>
                    </div>

                    <div class="schema-tabs">
                        <button class="data-tab active" data-data-tab="variables">
                            Variables
                        </button>
                        <button class="data-tab" data-data-tab="constants">
                            Constants
                        </button>
                    </div>

                    <div id="variables-section" class="data-content">
                        <div class="schema-toolbar">
                            <div>
                                <h3>Variables</h3>
                                <p class="hint">Values assigned while your workflow executes.</p>
                            </div>
                            <button id="add-variable" class="primary">
                                + Add variable
                            </button>
                        </div>

                        <div id="variables-list">
                            <p class="muted">No variables defined yet.</p>
                        </div>
                    </div>

                    <div id="constants-section" class="data-content hidden">
                        <div class="schema-toolbar">
                            <div>
                                <h3>Constants</h3>
                                <p class="hint">Fixed values available throughout your workflow.</p>
                            </div>
                            <button id="add-constant" class="primary">
                                + Add constant
                            </button>
                        </div>

                        <div id="constants-list">
                            <p class="muted">No constants defined yet.</p>
                        </div>
                    </div>
                </section>

                
                <section id="test" class="panel hidden">
                    <div class="heading">
                        <div>
                            <h1>Test rule</h1>
                            <p>
                                Run the connected decision tables in graph order.
                                Each table receives the input and outputs from earlier tables.
                            </p>
                        </div>
                    </div>

                    <div class="test-toolbar">
                        <div>
                            <strong>Test input</strong>
                            <p class="hint">Provide the data your workflow will evaluate.</p>
                        </div>

                        <div class="schema-tabs">
                            <button type="button" class="test-mode active" data-test-mode="json">
                                JSON
                            </button>
                            <button type="button" class="test-mode" data-test-mode="form">
                                Form
                            </button>
                        </div>
                    </div>

                    
                    <div class="testgrid testgrid-stacked">
                        <form id="testForm">
                            <div id="testJsonMode">
                                <label>
                                    Input JSON
                                    <textarea id="testInput">{
}</textarea>
                                </label>
                            </div>

                            <div id="testFormMode" class="hidden">
                                <div id="testInputFields">
                                    <p class="muted">Loading input fields...</p>
                                </div>
                            </div>

                            <div id="testCustomFields"></div>

                            <button type="submit">Run flow</button>
                        </form>

                        <div class="resultbox">
                            <b>RESPONSE</b>
                            <pre id="result">Run a decision to see output.</pre>
                        </div>
                    </div>

                </section>

                <!-- RESPONSE EDITOR -->
                <div id="responsePanel" class="response-editor hidden">
                    <div class="response-editor-content">
                        <div class="heading">
                            <div>
                                <h2>Configure response</h2>
                                <p>Map workflow values to your output schema.</p>
                            </div>
                            <button type="button" id="closeResponse">×</button>
                        </div>

                        <div id="responseMappings"></div>

                        <div class="response-editor-actions">
                            <button type="button" id="cancelResponse">Cancel</button>
                            <button type="button" id="saveResponse" class="primary">
                                Save response
                            </button>
                        </div>
                    </div>
                </div>

                <!-- EXPRESSION EDITOR -->
                <div id="expressionPanel" class="response-editor hidden">
                    <div class="response-editor-content">
                        <div class="heading">
                            <div>
                                <h2>Configure expressions</h2>
                                <p>Define calculated values for your workflow.</p>
                            </div>
                            <button type="button" id="closeExpression">×</button>
                        </div>

                        <div id="expressionAssignments"></div>

                        <div class="response-editor-actions">
                            <button type="button" id="addExpression">
                                + Add assignment
                            </button>
                            <button type="button" id="cancelExpression">Cancel</button>
                            <button type="button" id="saveExpression" class="primary">
                                Save expressions
                            </button>
                        </div>
                    </div>
                </div>

            </main>
